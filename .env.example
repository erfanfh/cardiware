APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Optional fallback. The admin panel value takes precedence when it is set.
LAUNCHER_PUBLIC_DOWNLOAD_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moddingwayy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
REDIS_DOWNLOAD_INTEGRITY_CONNECTION=default
REDIS_DOWNLOAD_INTEGRITY_QUEUE=download-integrity
REDIS_DOWNLOAD_INTEGRITY_RETRY_AFTER=1860

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_DOWNLOAD_COUNTER_TIMEOUT=0.25
CACHE_DOWNLOAD_CLICKS_DEDUP_MINUTES=30
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Encrypted backups on Pars Pack S3-compatible Object Storage
# Keep these values only in the server environment; never store them in admin settings.
PARSPACK_BACKUP_ACCESS_KEY=
PARSPACK_BACKUP_SECRET_KEY=
PARSPACK_BACKUP_REGION=
PARSPACK_BACKUP_BUCKET=
PARSPACK_BACKUP_ENDPOINT=
PARSPACK_BACKUP_URL=
PARSPACK_BACKUP_PREFIX=backups
PARSPACK_BACKUP_USE_PATH_STYLE_ENDPOINT=false
# Use a unique random value of at least 32 characters and store a copy offline.
BACKUP_ARCHIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# MW Launcher
LAUNCHER_MAX_ACTIVE_DEVICES=2
LAUNCHER_TOKEN_TTL_DAYS=30
LAUNCHER_CHECKOUT_SESSION_TTL_MINUTES=15
LAUNCHER_LATEST_VERSION=1.0.0
LAUNCHER_MINIMUM_SUPPORTED_VERSION=1.0.0
LAUNCHER_DOWNLOAD_URL=
LAUNCHER_MAINTENANCE_ENABLED=false
LAUNCHER_MAINTENANCE_MESSAGE="سرویس موقتا در دسترس نیست."
LAUNCHER_FORCE_UPDATE=false
LAUNCHER_BOOTSTRAP_CACHE_TTL_SECONDS=3600
LAUNCHER_DOWNLOAD_URL_TTL_MINUTES=60
LAUNCHER_DOWNLOAD_SESSION_LEASE_MINUTES=10080
LAUNCHER_ALLOWED_DOWNLOAD_HOSTS=
LAUNCHER_UPDATE_SIGNATURE=
LAUNCHER_UPDATE_SIGNATURE_KEY_ID=
LAUNCHER_REQUIRE_SOURCE_FILE_NAME_MATCH=true
